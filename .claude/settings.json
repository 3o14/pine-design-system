{
  "permissions": {
    "allow": [
      "Bash(pnpm run lint)",
      "Bash(pnpm run test:run)",
      "Bash(pnpm run build)",
      "Bash(pnpm run storybook)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(ls*)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(.pnpm-store/**)",
      "Read(dist/**)",
      "Read(dist-ssr/**)",
      "Read(storybook-static/**)",
      "Read(docs/out/**)",
      "Read(docs/.next/**)",
      "Read(pnpm-lock.yaml)",
      "Read(**/*.tsbuildinfo)",
      "Read(vite.config.ts.timestamp-*)",
      "Read(**/*.log)",
      "Read(.omc/**)",
      "Read(.DS_Store)",
      "Read(.vercel/**)",
      "Read(CHANGELOG.md)"
    ]
  }
}
